{
  "info": {
    "_postman_id": "5c810313-d453-4a3b-91b3-meeta-admin-api",
    "name": "Meeta Admin API",
    "description": "Frontend-ready admin APIs for marketplace governance. Catalogue sequence: create parent/child categories, create reusable attributes and values, then approve vendor products after verifying images, variants, option mappings, price, dimensions and inventory. Login with an admin account first; the token is saved automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://meeta.acttconnect.com/api" },
    { "key": "token", "value": "" },
    { "key": "vendor_id", "value": "1" },
    { "key": "category_id", "value": "1" },
    { "key": "brand_id", "value": "1" },
    { "key": "attribute_id", "value": "1" },
    { "key": "attribute_value_id", "value": "1" },
    { "key": "product_id", "value": "1" }
  ],
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "item": [
    {
      "name": "Authentication",
      "item": [
        { "name": "Admin Login", "auth": { "type": "noauth" }, "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "const token = json.token || json.data?.token || json.access_token;", "if (token) pm.collectionVariables.set('token', token);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}" }, "url": "{{base_url}}/login" } },
        { "name": "Profile", "request": { "method": "GET", "url": "{{base_url}}/profile" } },
        { "name": "Logout", "request": { "method": "POST", "url": "{{base_url}}/logout" } }
      ]
    },
    {
      "name": "Dashboard",
      "item": [{ "name": "Dashboard", "request": { "method": "GET", "url": "{{base_url}}/admin/dashboard" } }]
    },
    {
      "name": "Vendors",
      "item": [
        { "name": "List Vendors", "request": { "method": "GET", "description": "Use case: admin vendor-management list. Pending applications are prioritized first and ordered by submitted_at descending, so a newly submitted or reapplied application immediately returns to the top of the review queue. created_at remains the original join date.", "url": "{{base_url}}/admin/vendors?page=1" } },
        { "name": "Pending Vendors", "request": { "method": "GET", "description": "Dedicated review queue ordered by the latest submitted_at timestamp, not vendor creation date. Reapplication updates submitted_at while preserving the vendor ID and original created_at.", "url": "{{base_url}}/admin/vendors/pending?page=1" } },
        { "name": "Vendor Detail", "request": { "method": "GET", "url": "{{base_url}}/admin/vendors/{{vendor_id}}" } },
        { "name": "Approve Vendor", "request": { "method": "POST", "url": "{{base_url}}/admin/vendors/{{vendor_id}}/approve" } },
        { "name": "Reject Vendor", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"rejection_reason\": \"Documents could not be verified.\"\n}" }, "url": "{{base_url}}/admin/vendors/{{vendor_id}}/reject" } },
        { "name": "Suspend Vendor", "request": { "method": "POST", "url": "{{base_url}}/admin/vendors/{{vendor_id}}/suspend" } }
      ]
    },
    {
      "name": "Categories",
      "item": [
        { "name": "List Categories", "request": { "method": "GET", "url": "{{base_url}}/admin/categories?page=1" } },
        { "name": "Category Tree", "request": { "method": "GET", "url": "{{base_url}}/admin/categories/tree" } },
        { "name": "Category Detail", "request": { "method": "GET", "url": "{{base_url}}/admin/categories/{{category_id}}" } },
        { "name": "Create Category", "request": { "method": "POST", "description": "Use case: create a root category with parent_id empty, or a storefront child category by passing its parent category ID. Products should normally use the most specific active child category.", "body": { "mode": "formdata", "formdata": [{ "key": "parent_id", "value": "1", "type": "text" }, { "key": "name", "value": "Pottery", "type": "text" }, { "key": "description", "value": "Handcrafted pottery", "type": "text" }, { "key": "sort_order", "value": "1", "type": "text" }, { "key": "is_active", "value": "1", "type": "text" }, { "key": "image", "type": "file", "src": [] }] }, "url": "{{base_url}}/admin/categories" } },
        { "name": "Update Category", "request": { "method": "PUT", "body": { "mode": "formdata", "formdata": [{ "key": "name", "value": "Pottery & Ceramics", "type": "text" }, { "key": "description", "value": "Updated description", "type": "text" }, { "key": "is_active", "value": "1", "type": "text" }] }, "url": "{{base_url}}/admin/categories/{{category_id}}" } },
        { "name": "Update Category Status", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"is_active\": true }" }, "url": "{{base_url}}/admin/categories/{{category_id}}/status" } },
        { "name": "Delete Category", "request": { "method": "DELETE", "url": "{{base_url}}/admin/categories/{{category_id}}" } }
      ]
    },
    {
      "name": "Brands",
      "item": [
        { "name": "List Brands", "request": { "method": "GET", "url": "{{base_url}}/admin/brands?page=1" } },
        { "name": "Brand Detail", "request": { "method": "GET", "url": "{{base_url}}/admin/brands/{{brand_id}}" } },
        { "name": "Create Brand", "request": { "method": "POST", "body": { "mode": "formdata", "formdata": [{ "key": "name", "value": "Meeta Heritage", "type": "text" }, { "key": "description", "value": "Indian artisan brand", "type": "text" }, { "key": "website", "value": "https://example.com", "type": "text" }, { "key": "status", "value": "active", "type": "text" }, { "key": "logo", "type": "file", "src": [] }] }, "url": "{{base_url}}/admin/brands" } },
        { "name": "Update Brand", "request": { "method": "PUT", "body": { "mode": "formdata", "formdata": [{ "key": "name", "value": "Meeta Heritage Updated", "type": "text" }, { "key": "status", "value": "active", "type": "text" }] }, "url": "{{base_url}}/admin/brands/{{brand_id}}" } },
        { "name": "Update Brand Status", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"active\" }" }, "url": "{{base_url}}/admin/brands/{{brand_id}}/status" } },
        { "name": "Delete Brand", "request": { "method": "DELETE", "url": "{{base_url}}/admin/brands/{{brand_id}}" } }
      ]
    },
    {
      "name": "Attributes",
      "item": [
        { "name": "List Attributes", "request": { "method": "GET", "url": "{{base_url}}/admin/attributes?page=1" } },
        { "name": "Attribute Detail", "request": { "method": "GET", "url": "{{base_url}}/admin/attributes/{{attribute_id}}" } },
        { "name": "Create Attribute", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Color\",\n  \"status\": \"active\"\n}" }, "url": "{{base_url}}/admin/attributes" } },
        { "name": "Update Attribute", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Primary Color\",\n  \"status\": \"active\"\n}" }, "url": "{{base_url}}/admin/attributes/{{attribute_id}}" } },
        { "name": "Update Attribute Status", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"active\" }" }, "url": "{{base_url}}/admin/attributes/{{attribute_id}}/status" } },
        { "name": "Delete Attribute", "request": { "method": "DELETE", "url": "{{base_url}}/admin/attributes/{{attribute_id}}" } }
      ]
    },
    {
      "name": "Attribute Values",
      "item": [
        { "name": "List Attribute Values", "request": { "method": "GET", "url": "{{base_url}}/admin/attribute-values?page=1&attribute_id={{attribute_id}}" } },
        { "name": "Attribute Value Detail", "request": { "method": "GET", "url": "{{base_url}}/admin/attribute-values/{{attribute_value_id}}" } },
        { "name": "Create Attribute Value", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"attribute_id\": {{attribute_id}},\n  \"value\": \"Blue\",\n  \"sort_order\": 1,\n  \"status\": \"active\"\n}" }, "url": "{{base_url}}/admin/attribute-values" } },
        { "name": "Update Attribute Value", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"value\": \"Royal Blue\",\n  \"status\": \"active\"\n}" }, "url": "{{base_url}}/admin/attribute-values/{{attribute_value_id}}" } },
        { "name": "Update Attribute Value Status", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"active\" }" }, "url": "{{base_url}}/admin/attribute-values/{{attribute_value_id}}/status" } },
        { "name": "Delete Attribute Value", "request": { "method": "DELETE", "url": "{{base_url}}/admin/attribute-values/{{attribute_value_id}}" } }
      ]
    },
    {
      "name": "Product Approvals",
      "item": [
        { "name": "Pending Products", "request": { "method": "GET", "url": "{{base_url}}/admin/products/pending?page=1" } },
        { "name": "Product Detail", "request": { "method": "GET", "description": "Use case: approval review. Confirm category, gallery, every sellable variant combination, attributes, dimensions, price and stock before approving.", "url": "{{base_url}}/admin/products/{{product_id}}" } },
        { "name": "Approve Product", "request": { "method": "POST", "url": "{{base_url}}/admin/products/{{product_id}}/approve" } },
        { "name": "Reject Product", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"rejection_reason\": \"Product information requires correction.\"\n}" }, "url": "{{base_url}}/admin/products/{{product_id}}/reject" } }
      ]
    }
  ]
}
