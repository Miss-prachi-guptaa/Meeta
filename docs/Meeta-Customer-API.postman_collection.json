{
  "info": { "name": "MEETA Customer API", "description": "Frontend-ready customer commerce APIs. Order history uses a lightweight card response; order detail returns the complete purchase-time item, address, payment, package and tracking structure.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [
    { "key": "base_url", "value": "https://meeta.acttconnect.com/api" },
    { "key": "token", "value": "" },
    { "key": "product_slug", "value": "wooden-vase" },
    { "key": "variant_id", "value": "8" },
    { "key": "cart_item_id", "value": "1" },
    { "key": "wishlist_item_id", "value": "1" },
    { "key": "address_id", "value": "1" },
    { "key": "order_id", "value": "1" }
  ],
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "item": [
    { "name": "Authentication", "item": [
      { "name": "Register", "auth": { "type": "noauth" }, "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"first_name\": \"Aarav\",\n  \"last_name\": \"Sharma\",\n  \"email\": \"aarav@example.com\",\n  \"phone\": \"9876543210\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}" }, "url": "{{base_url}}/register" } },
      { "name": "Login", "auth": { "type": "noauth" }, "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.token) pm.collectionVariables.set('token', json.token);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"aarav@example.com\",\n  \"password\": \"password123\"\n}" }, "url": "{{base_url}}/login" } },
      { "name": "Profile", "request": { "method": "GET", "url": "{{base_url}}/profile" } },
      { "name": "Logout", "request": { "method": "POST", "url": "{{base_url}}/logout" } }
    ] },
    { "name": "Public Storefront", "item": [
      { "name": "Homepage", "auth": { "type": "noauth" }, "request": { "method": "GET", "url": "{{base_url}}/home?per_page=12" } },
      { "name": "Categories", "auth": { "type": "noauth" }, "request": { "method": "GET", "url": "{{base_url}}/customer/categories" } },
      { "name": "Products", "auth": { "type": "noauth" }, "request": { "method": "GET", "url": "{{base_url}}/customer/products?sort=latest&per_page=12" } },
      { "name": "Product Detail", "auth": { "type": "noauth" }, "request": { "method": "GET", "description": "Use case: product gallery and professional variant picker. option_groups drives Color/Size/Finish buttons; variants provides valid combinations, SKU, price, stock and attribute value IDs. Add the resolved variant.id to cart or wishlist.", "url": "{{base_url}}/customer/products/{{product_slug}}" }, "response": [{ "name": "200 Variant-ready product", "originalRequest": { "method": "GET", "url": "{{base_url}}/customer/products/{{product_slug}}" }, "status": "OK", "code": 200, "_postman_previewlanguage": "json", "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"success\": true,\n  \"data\": {\n    \"name\": \"Jaipur Blue Pottery Floral Vase\",\n    \"images\": [{ \"url\": \"/images/catalog/jaipur-blue-pottery-vase-1.webp\", \"is_primary\": true }],\n    \"option_groups\": [\n      { \"id\": 1, \"name\": \"Color\", \"slug\": \"color\", \"values\": [{ \"id\": 10, \"value\": \"Cobalt Blue\", \"slug\": \"cobalt-blue\" }] },\n      { \"id\": 2, \"name\": \"Size\", \"slug\": \"size\", \"values\": [{ \"id\": 20, \"value\": \"Small\", \"slug\": \"small\" }] }\n    ],\n    \"variants\": [{\n      \"id\": 101, \"sku\": \"JBP-CB-S\", \"name\": \"Cobalt Blue / Small\",\n      \"price\": 1299, \"sale_price\": 1099, \"effective_price\": 1099,\n      \"in_stock\": true, \"available_quantity\": 24,\n      \"attributes\": [{ \"attribute_slug\": \"color\", \"value_id\": 10, \"value\": \"Cobalt Blue\" }]\n    }]\n  }\n}" }] },
      { "name": "Search Suggestions", "auth": { "type": "noauth" }, "request": { "method": "GET", "url": "{{base_url}}/customer/search/suggestions?q=wood&limit=8" } }
    ] },
    { "name": "Cart", "item": [
      { "name": "Get Cart", "request": { "method": "GET", "url": "{{base_url}}/customer/cart" } },
      { "name": "Add Item", "request": { "method": "POST", "description": "Use case: Add to Cart and Buy Now both require the exact variant.id resolved from Product Detail option_groups. Do not send a product ID or a default variant for products with options. Missing, unknown, inactive and out-of-stock variants return 422 with errors.product_variant_id; excessive quantity returns 422 with errors.quantity.", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"product_variant_id\": {{variant_id}},\n  \"quantity\": 1\n}" }, "url": "{{base_url}}/customer/cart/items" }, "response": [{ "name": "422 Option selection required", "originalRequest": { "method": "POST", "url": "{{base_url}}/customer/cart/items" }, "status": "Unprocessable Content", "code": 422, "_postman_previewlanguage": "json", "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"message\": \"Please select the required product options before adding this item to your cart.\",\n  \"errors\": {\n    \"product_variant_id\": [\"Please select the required product options before adding this item to your cart.\"]\n  }\n}" }] },
      { "name": "Update Quantity", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"quantity\": 2 }" }, "url": "{{base_url}}/customer/cart/items/{{cart_item_id}}" } },
      { "name": "Move to Wishlist", "request": { "method": "POST", "url": "{{base_url}}/customer/cart/items/{{cart_item_id}}/move-to-wishlist" } },
      { "name": "Remove Item", "request": { "method": "DELETE", "url": "{{base_url}}/customer/cart/items/{{cart_item_id}}" } },
      { "name": "Clear Cart", "request": { "method": "DELETE", "url": "{{base_url}}/customer/cart" } }
    ] },
    { "name": "Wishlist", "item": [
      { "name": "Get Wishlist", "request": { "method": "GET", "url": "{{base_url}}/customer/wishlist" } },
      { "name": "Add Item", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"product_variant_id\": {{variant_id}} }" }, "url": "{{base_url}}/customer/wishlist/items" } },
      { "name": "Move to Cart", "request": { "method": "POST", "url": "{{base_url}}/customer/wishlist/items/{{wishlist_item_id}}/move-to-cart" } },
      { "name": "Remove Item", "request": { "method": "DELETE", "url": "{{base_url}}/customer/wishlist/items/{{wishlist_item_id}}" } },
      { "name": "Clear Wishlist", "request": { "method": "DELETE", "url": "{{base_url}}/customer/wishlist" } }
    ] },
    { "name": "Addresses", "item": [
      { "name": "List Addresses", "request": { "method": "GET", "url": "{{base_url}}/customer/addresses" } },
      { "name": "Create Address", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"label\": \"Home\",\n  \"full_name\": \"Aarav Sharma\",\n  \"phone\": \"9876543210\",\n  \"address_line_1\": \"House 20, MG Road\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"country\": \"India\",\n  \"postal_code\": \"400001\",\n  \"is_default\": true\n}" }, "url": "{{base_url}}/customer/addresses" } },
      { "name": "Get Address", "request": { "method": "GET", "url": "{{base_url}}/customer/addresses/{{address_id}}" } },
      { "name": "Update Address", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"label\": \"Home\",\n  \"full_name\": \"Aarav Sharma\",\n  \"phone\": \"9876543210\",\n  \"address_line_1\": \"House 21, MG Road\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"country\": \"India\",\n  \"postal_code\": \"400001\"\n}" }, "url": "{{base_url}}/customer/addresses/{{address_id}}" } },
      { "name": "Make Default", "request": { "method": "PATCH", "url": "{{base_url}}/customer/addresses/{{address_id}}/default" } },
      { "name": "Delete Address", "request": { "method": "DELETE", "url": "{{base_url}}/customer/addresses/{{address_id}}" } }
    ] },
    { "name": "Checkout & Orders", "item": [
      { "name": "Checkout Preview", "request": { "method": "GET", "url": "{{base_url}}/customer/checkout?shipping_method=standard" } },
      { "name": "Place COD Order", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"address_id\": {{address_id}},\n  \"shipping_method\": \"standard\",\n  \"payment_method\": \"cod\",\n  \"notes\": null\n}" }, "url": "{{base_url}}/customer/checkout/place-order" } },
      { "name": "Buy Now Preview", "request": { "method": "GET", "description": "Use case: preview only the selected product variant without adding it to or reading other items from the cart. Existing cart remains untouched.", "url": "{{base_url}}/customer/checkout?mode=buy_now&product_variant_id={{variant_id}}&quantity=1&shipping_method=standard" } },
      { "name": "Place Buy Now COD Order", "request": { "method": "POST", "description": "Use case: place an order containing only the chosen Buy Now variant. This does not delete or change any existing cart items.", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"mode\": \"buy_now\",\n  \"product_variant_id\": {{variant_id}},\n  \"quantity\": 1,\n  \"address_id\": {{address_id}},\n  \"shipping_method\": \"standard\",\n  \"payment_method\": \"cod\",\n  \"notes\": null\n}" }, "url": "{{base_url}}/customer/checkout/place-order" } },
      { "name": "Order History", "request": { "method": "GET", "description": "Use case: paginated My Orders cards. Optional filters: status, year, per_page. Returns preview images, item/package counts and cancellation eligibility.", "url": "{{base_url}}/customer/orders?page=1&per_page=8&status=&year=" }, "response": [{ "name": "200 Success", "originalRequest": { "method": "GET", "url": "{{base_url}}/customer/orders?page=1" }, "status": "OK", "code": 200, "_postman_previewlanguage": "json", "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"success\": true,\n  \"data\": {\n    \"orders\": [{\n      \"id\": 1,\n      \"order_number\": \"MTA-260824-ABC12345\",\n      \"order_status\": \"processing\",\n      \"payment_status\": \"pending\",\n      \"total_amount\": 1299,\n      \"total_items\": 2,\n      \"total_packages\": 1,\n      \"can_cancel\": false,\n      \"preview_items\": []\n    }],\n    \"pagination\": { \"current_page\": 1, \"last_page\": 1, \"per_page\": 8, \"total\": 1 }\n  }\n}" }] },
      { "name": "Order Detail", "request": { "method": "GET", "description": "Use case: complete owned order detail. Includes purchase-time delivery-address snapshot, amount breakup, payment, vendor packages, item images/prices and shipment timelines. Another customer's order returns 404.", "url": "{{base_url}}/customer/orders/{{order_id}}" }, "response": [{ "name": "200 Success", "originalRequest": { "method": "GET", "url": "{{base_url}}/customer/orders/{{order_id}}" }, "status": "OK", "code": 200, "_postman_previewlanguage": "json", "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": 1,\n    \"order_number\": \"MTA-260824-ABC12345\",\n    \"order_status\": \"shipped\",\n    \"can_cancel\": false,\n    \"delivery_address\": { \"full_name\": \"Aarav Sharma\", \"city\": \"Jaipur\", \"postal_code\": \"302001\" },\n    \"amounts\": { \"subtotal\": 1250, \"shipping\": 49, \"total\": 1299 },\n    \"payment\": { \"method\": \"cod\", \"status\": \"pending\" },\n    \"packages\": [{ \"vendor\": { \"name\": \"Meera Handicrafts\" }, \"status\": \"shipped\", \"items\": [], \"shipment\": { \"tracking_number\": \"DUM260824ABC12345\", \"status\": \"in_transit\", \"tracking\": [] } }]\n  }\n}" }] }
    ] },
    { "name": "Customer Account", "item": [
      { "name": "Account Dashboard", "request": { "method": "GET", "url": "{{base_url}}/customer/account/dashboard" } },
      { "name": "Get Profile", "request": { "method": "GET", "url": "{{base_url}}/customer/account/profile" } },
      { "name": "Update Profile JSON", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"first_name\": \"Aarav\",\n  \"last_name\": \"Sharma\",\n  \"display_name\": \"Aarav\",\n  \"phone\": \"9876543210\",\n  \"gender\": \"male\",\n  \"date_of_birth\": \"1995-04-15\"\n}" }, "url": "{{base_url}}/customer/account/profile" } },
      { "name": "Update Profile Image", "request": { "method": "POST", "body": { "mode": "formdata", "formdata": [{ "key": "profile_image", "type": "file", "src": [] }] }, "url": "{{base_url}}/customer/account/profile" } },
      { "name": "Change Password", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"current_password\": \"password123\",\n  \"password\": \"newPassword123\",\n  \"password_confirmation\": \"newPassword123\",\n  \"logout_other_devices\": true\n}" }, "url": "{{base_url}}/customer/account/password" } },
      { "name": "Get Preferences", "request": { "method": "GET", "url": "{{base_url}}/customer/account/preferences" } },
      { "name": "Update Preferences", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"order_updates\": true,\n  \"promotional_emails\": false,\n  \"artisan_stories\": true,\n  \"language\": \"en\",\n  \"currency\": \"INR\"\n}" }, "url": "{{base_url}}/customer/account/preferences" } },
      { "name": "Supported Artisans", "request": { "method": "GET", "url": "{{base_url}}/customer/account/supported-artisans?page=1" } },
      { "name": "Logout All Devices", "request": { "method": "POST", "url": "{{base_url}}/customer/account/logout-all" } },
      { "name": "Delete Account", "request": { "method": "DELETE", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"password\": \"password123\", \"confirmation\": \"DELETE\" }" }, "url": "{{base_url}}/customer/account" } }
    ] },
    { "name": "Post-purchase", "item": [
      { "name": "Cancel Order", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"reason\": \"Ordered the wrong variant\" }" }, "url": "{{base_url}}/customer/orders/{{order_id}}/cancel" } },
      { "name": "Order Tracking", "request": { "method": "GET", "url": "{{base_url}}/customer/orders/{{order_id}}/tracking" } },
      { "name": "Invoice Data", "request": { "method": "GET", "url": "{{base_url}}/customer/orders/{{order_id}}/invoice" } },
      { "name": "My Reviews", "request": { "method": "GET", "url": "{{base_url}}/customer/reviews?page=1" } },
      { "name": "Create Review", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"order_item_id\": 1,\n  \"rating\": 5,\n  \"title\": \"Beautiful craftsmanship\",\n  \"review_text\": \"The piece is even better in person.\"\n}" }, "url": "{{base_url}}/customer/reviews" } },
      { "name": "Update Review", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"rating\": 4, \"title\": \"Lovely piece\", \"review_text\": \"Updated review.\" }" }, "url": "{{base_url}}/customer/reviews/1" } },
      { "name": "Delete Review", "request": { "method": "DELETE", "url": "{{base_url}}/customer/reviews/1" } },
      { "name": "Notifications", "request": { "method": "GET", "url": "{{base_url}}/customer/notifications?page=1" } },
      { "name": "Unread Notifications", "request": { "method": "GET", "url": "{{base_url}}/customer/notifications?unread_only=1" } },
      { "name": "Mark Notification Read", "request": { "method": "PATCH", "url": "{{base_url}}/customer/notifications/1/read" } },
      { "name": "Mark All Notifications Read", "request": { "method": "PATCH", "url": "{{base_url}}/customer/notifications/read-all" } },
      { "name": "Delete Notification", "request": { "method": "DELETE", "url": "{{base_url}}/customer/notifications/1" } }
    ] },
    { "name": "Newsletter", "item": [
      { "name": "Subscribe", "auth": { "type": "noauth" }, "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"email\": \"aarav@example.com\" }" }, "url": "{{base_url}}/newsletter/subscribe" } }
    ] }
  ]
}
